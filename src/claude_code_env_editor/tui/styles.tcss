/* Claude Code look: dark surface, orange accent, rounded boxes. */
$accent: #d97757;
$muted: #8a8580;

Screen { background: #1c1b1a; color: #e8e4de; }

#banner {
    height: 6;
    margin: 1 2 0 2;
    padding: 0 2;
    border: round $accent;
    color: #e8e4de;
}
#banner .title { color: $accent; text-style: bold; }

#table-box {
    margin: 1 2 0 2;
    border: round #4a4743;
    height: 1fr;
}
DataTable { background: #1c1b1a; height: 1fr; }
DataTable > .datatable--cursor { background: $accent 30%; color: #ffffff; }
DataTable > .datatable--header { background: #26241f; color: $accent; text-style: bold; }

#status { margin: 0 2; height: 1; color: $muted; }

Footer { background: #1c1b1a; color: $muted; }
Footer .footer--key { background: $accent; color: #1c1b1a; }

ModalScreen { align: center middle; background: #000000 60%; }
.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $accent;
    background: #1c1b1a;
}
.dialog .heading { color: $accent; text-style: bold; margin-bottom: 1; }
.dialog .hint { color: $muted; margin-top: 1; }
.dialog Input { border: round #4a4743; background: #26241f; }
.dialog Input:focus { border: round $accent; }
.dialog OptionList { border: round #4a4743; height: auto; max-height: 14; background: #1c1b1a; }
.dialog OptionList:focus { border: round $accent; }
.ok { color: #7fb069; }
.fail { color: #e5534b; }
.skip { color: $muted; }

#question-box { height: auto; max-height: 18; }
